{
  "title": "Custom Key Mappings",
  "rules": [
    {
      "description": "Right CMD → Hyper Key (held) / Right CMD (tapped)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_command", "left_control", "left_option"]
            }
          ],
          "to_if_alone": [{ "key_code": "right_command" }]
        }
      ]
    },
    {
      "description": "Hyper+C → Open Chrome",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["left_shift", "left_command", "left_control", "left_option"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Google Chrome'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper+F → Open Kitty",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f",
            "modifiers": {
              "mandatory": ["left_shift", "left_command", "left_control", "left_option"]
            }
          },
          "to": [{ "shell_command": "open -a 'kitty'" }]
        }
      ]
    },
    {
      "description": "Hyper+M → Open Outlook",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "m",
            "modifiers": {
              "mandatory": ["left_shift", "left_command", "left_control", "left_option"]
            }
          },
          "to": [{ "shell_command": "open -a 'Microsoft Outlook'" }]
        }
      ]
    },
    {
      "description": "Hyper+G → Open Teams",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "g",
            "modifiers": {
              "mandatory": ["left_shift", "left_command", "left_control", "left_option"]
            }
          },
          "to": [{ "shell_command": "open -a 'Microsoft Teams'" }]
        }
      ]
    },
    {
      "description": "Hyper+D → Open Helium",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": ["left_shift", "left_command", "left_control", "left_option"]
            }
          },
          "to": [{ "shell_command": "open -a 'Helium'" }]
        }
      ]
    },
    {
      "description": "Disable Caps Lock",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "vk_none" }]
        }
      ]
    }
  ]
}
