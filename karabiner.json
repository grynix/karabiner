{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Hyper+D → Open Helium",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "d",
                                    "modifiers": { "mandatory": ["left_shift", "left_command", "left_control", "left_option"] }
                                },
                                "to": [{ "shell_command": "open -a 'Helium'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper+G → Open Teams",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "g",
