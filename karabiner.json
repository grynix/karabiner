                                },
                                "to": [{ "shell_command": "open -a 'Microsoft Teams'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Disable Caps Lock",
                        "manipulators": [
                            {
                                "from": {
